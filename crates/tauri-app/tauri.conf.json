{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Chimera",
  "version": "0.1.0",
  "identifier": "ai.chimera.app",
  "build": {
    "beforeDevCommand": "",
    "beforeBuildCommand": "",
    "devPath": "http://localhost:1420",
    "distDir": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Chimera",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true,
        "fullscreen": false,
        "decorations": false,
        "transparent": true,
        "visible": true,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#18181B",
        "hiddenTitle": true,
        "titleBarStyle": "Overlay",
        "webviewVersion": null
      }
    ],
    "security": {
      "csp": "default-src 'self' ipc: data: blob:; script-src 'self' 'unsafe-inline' 'unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; connect-src 'self' ipc: ws: wss: http: https:; font-src 'self' data:; frame-src 'none'; object-src 'none'; base-uri 'none'; form-action 'none';"
    },
    "withGlobalTauri": true,
    "macOSPrivateApi": false
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embeddedBootstrapper"
      },
      "certificateThumbprint": "",
      "digestAlgorithm": "sha256",
      "timestampUrl": "",
      "tsp": false,
      "nsis": {
        "installerIcon": "icons/icon.ico",
        "installerHeaderIcon": "icons/icon.ico",
        "allowElevated": true,
        "allowToChangeInstallationDirectory": true,
        "createDesktopShortcut": "always",
        "createStartMenuShortcut": true,
        "shortcutName": "Chimera",
        "displayLanguageSelector": false,
        "licenseFile": "",
        "multiLanguageInstaller": false,
        "headerBitmap": "",
        "welcomeBitmap": "",
        "finishBitmap": "",
        "enableLogging": true
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    },
    "macOS": {
      "frameworks": [],
      "minimumSystemVersion": "10.15",
      "exceptionDomain": "",
      "signingIdentity": "",
      "providerShortName": "",
      "entitlements": null,
      "hardenedRuntime": true,
      "appCategoryType": "public.app-category.developer-tools",
      "infoPlist": {
        "NSHighResolutionCapable": true,
        "NSRequiresAquaSystemAppearance": false,
        "CFBundleDisplayName": "Chimera",
        "CFBundleName": "Chimera",
        "LSMinimumSystemVersion": "10.15",
        "NSPrincipalClass": "NSApplication",
        "NSHumanReadableCopyright": "© 2024 Chimera"
      },
      "dmg": {
        "title": "Chimera",
        "background": "icons/dmg-background.png",
        "window": {
          "width": 540,
          "height": 380
        },
        "iconSize": 100,
        "contents": [
          {
            "x": 180,
            "y": 170,
            "type": "file"
          },
          {
            "x": 360,
            "y": 170,
            "type": "link",
            "path": "/Applications"
          }
        ]
      }
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libgtk-3-0",
          "libayatana-appindicator3-1",
          "librsvg2-common"
        ],
        "section": "utils",
        "priority": "optional",
        "maintainer": "Chimera Team",
        "license": "MIT",
        "icon": "icons/128x128.png"
      },
      "appimage": {
        "bundleMediaFramework": true
      },
      "rpm": {
        "depends": [
          "webkit2gtk4.1",
          "gtk3",
          "libappindicator-gtk3",
          "librsvg2"
        ],
        "license": "MIT",
        "icon": "icons/128x128.png"
      },
      "flatpak": {
        "finishArgs": [
          "--share=network",
          "--share=ipc",
          "--socket=wayland",
          "--socket=fallback-x11",
          "--device=dri",
          "--filesystem=home",
          "--filesystem=xdg-run/tauri",
          "--talk-name=org.freedesktop.Notifications"
        ]
      }
    },
    "resources": [
      "resources/**/*"
    ],
    "externalBin": []
  },
  "plugins": {
    "shell": {
      "open": true
    },
    "fs": {
      "all": true,
      "scope": [
        "$APPDATA/**",
        "$APPCONFIG/**",
        "$APPDATA/chimera/**",
        "$APPCONFIG/chimera/**",
        "$HOME/.chimera/**",
        "$HOME/.config/chimera/**"
      ]
    }
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "window": {
        "all": false,
        "close": true,
        "hide": true,
        "show": true,
        "maximize": true,
        "minimize": true,
        "unmaximize": true,
        "unminimize": true,
        "startDragging": true,
        "setTitle": true,
        "setFullscreen": true,
        "setResizable": true,
        "setMinSize": true,
        "setMaxSize": true,
        "setPosition": true,
        "setSize": true,
        "setAlwaysOnTop": true,
        "setDecorations": true,
        "setIcon": true,
        "setSkipTaskbar": true,
        "setCursorGrab": true,
        "setCursorVisible": true,
        "setCursorIcon": true,
        "setIgnoreCursorEvents": true,
        "setContentProtected": true,
        "setFocus": true,
        "requestUserAttention": true,
        "center": true,
        "getMonitor": true,
        "getPosition": true,
        "getSize": true,
        "isFullscreen": true,
        "isMaximized": true,
        "isMinimized": true,
        "isDecorated": true,
        "isResizable": true,
        "isVisible": true,
        "currentMonitor": true,
        "primaryMonitor": true,
        "availableMonitors": true,
        "theme": true,
        "toggleMaximize": true,
        "print": true
      },
      "shell": {
        "all": false,
        "open": true,
        "scope": {
          "allow": [
            "https://github.com/**",
            "https://api.openai.com/**",
            "https://api.anthropic.com/**",
            "https://generativelanguage.googleapis.com/**",
            "https://api.mistral.ai/**",
            "https://api.cohere.ai/**",
            "http://localhost:11434/**"
          ]
        }
      },
      "fs": {
        "all": false,
        "readFile": true,
        "writeFile": true,
        "readDir": true,
        "copyFile": true,
        "createDir": true,
        "removeFile": true,
        "removeDir": true,
        "renameFile": true,
        "exists": true,
        "scope": {
          "allow": [
            "$APPDATA/chimera/**",
            "$APPCONFIG/chimera/**",
            "$HOME/.chimera/**",
            "$HOME/.config/chimera/**",
            "$DESKTOP/**",
            "$DOCUMENTS/**",
            "$DOWNLOAD/**"
          ]
        }
      },
      "dialog": {
        "all": false,
        "open": true,
        "save": true,
        "message": true,
        "ask": true,
        "confirm": true
      },
      "notification": {
        "all": true
      },
      "clipboard": {
        "all": true
      },
      "path": {
        "all": true
      },
      "process": {
        "all": false,
        "launch": true,
        "exit": true,
        "kill": true,
        "command": {
          "all": true,
          "sidecar": false,
          "scope": {
            "allow": [
              "bash",
              "sh",
              "cmd",
              "powershell",
              "python3",
              "node",
              "npm",
              "git",
              "cargo",
              "rustc"
            ]
          }
        }
      },
      "protocol": {
        "all": false,
        "asset": true,
        "assetScope": {
          "allow": [
            "$APPDATA/chimera/**",
            "$APPCONFIG/chimera/**"
          ]
        }
      }
    },
    "macOSPrivateApi": false,
    "pattern": {
      "use": "brownfield"
    }
  }
}